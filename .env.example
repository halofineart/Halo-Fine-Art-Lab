# --- Supabase (base de datos + auth) ---
# Estas dos son públicas (se usan en el navegador), se consiguen en
# Supabase → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SECRETA — solo la usan las funciones /api en el servidor, NUNCA debe
# empezar con VITE_ (eso la mandaría al navegador). Se consigue en
# Supabase → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago ---
# SECRETA — Access Token de tu aplicación en
# https://www.mercadopago.com.ar/developers/panel → Tus aplicaciones →
# Credenciales de producción (o "Credenciales de prueba" para testear).
# Solo se usa en el servidor (/api), nunca en el navegador.
MP_ACCESS_TOKEN=

# Se genera automáticamente en Mercado Pago la primera vez que configurás
# el webhook (Tu aplicación → Webhooks → URL: https://tu-dominio/api/mp-webhook,
# evento "Pagos"). Copiá la "Firma secreta" acá. Si se deja vacío, el
# webhook igual funciona pero sin validar que la notificación es realmente
# de Mercado Pago — recomendado configurarlo antes de cobrar en serio.
MP_WEBHOOK_SECRET=

# Opcional — dominio público del sitio (https://tu-dominio.com, sin barra
# final). Si no se define, se infiere del header Host de cada request, que
# funciona bien en Vercel.
PUBLIC_SITE_URL=
